# <AI>
import lldb
import os
import subprocess


def select_useful_frame(debugger, command, result, internal_dict):
    target = debugger.GetSelectedTarget()
    process = target.GetProcess()

    if not process.IsValid():
        return

    thread = process.GetSelectedThread()

    if not thread.IsValid():
        return

    # Only interfere with exception/signal stops.
    stop_reason = thread.GetStopReason()

    allowed_reasons = {
        lldb.eStopReasonException,
        lldb.eStopReasonSignal,
    }

    if stop_reason not in allowed_reasons:
        return

    workspace = os.getcwd()

    for i in range(thread.GetNumFrames()):
        frame = thread.GetFrameAtIndex(i)

        if not frame.IsValid():
            continue

        # Reject frames without source information.
        line_entry = frame.GetLineEntry()

        if not line_entry.IsValid():
            continue

        file_spec = line_entry.GetFileSpec()

        if not file_spec.IsValid():
            continue

        path = file_spec.GetPath()

        if not path:
            continue

        # Reject assembly / unnamed symbols.
        function_name = frame.GetDisplayFunctionName()

        if not function_name:
            continue

        if function_name.startswith("___lldb_unnamed_symbol"):
            continue

        # Make the path absolute where possible.
        if not os.path.isabs(path):
            path = os.path.abspath(path)

        # Reject anything inside lib/.
        try:
            rel = os.path.relpath(path, workspace)
        except ValueError:
            continue

        parts = rel.split(os.sep)

        if "lib" in parts:
            continue

        # Reject Git-ignored files.
        try:
            ignored = subprocess.run(
                ["git", "check-ignore", "-q", "--", path],
                cwd=workspace,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ).returncode == 0
        except Exception:
            ignored = False

        if ignored:
            continue

        # This is our first useful frame.
        thread.SetSelectedFrame(i)
        return

def __lldb_init_module(debugger, internal_dict):
    debugger.HandleCommand(
        "command script add -f __main__.select_useful_frame select-useful-frame"
    )

    debugger.HandleCommand(
        "target stop-hook add -o select-useful-frame"
    )

# </AI>
